{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":220,"erCode":"/* Entities */\nentity PARCHI {\n    Tipologia,\n    Ente_Gestore,\n    Regione,\n    Superficie_terrestre,\n    Nome_parco,\n    Superficie_marina,\n    provvedimento_istitutivo,\n    Km_costa,\n    ID (id)\n}\nentity CENTRI_VISITA {\n    Orario_apertura,\n    Luogo,\n    Orario_chiusura,\n    Nome_centro,\n    Email,\n    Num_telefono,\n    Percorsi,\n    Visite,\n    COD (id)\n}\nentity VISITATORI {\n    Password,\n    Tipologia,\n    Username (id)\n}\nentity VALUTAZIONI {\n    Commento,\n    ID (id),\n    Punteggio\n}\nentity PRESENZE {\n    Tipologia_utente,\n    Orario_entrata,\n    Orario_uscita,\n    Data,\n    COD (id)\n}\nentity GUIDE_AUTORIZZATE {\n    Cognome,\n    Nome,\n    Media_valutazione,\n    COD (id)\n}\nentity ITINERARI {\n    ID (id),\n    Media_valutazione,\n    Numero_guide_abilitate,\n    Tempo_stimato,\n    Modalita_percorrenza,\n    Punto_partenza,\n    Livello_difficolta\n}\nentity TOUR_PROGRAMMATI {\n    Num_massimo_partecipanti,\n    Orario (id),\n    Stato,\n    Anno\n}\nentity STRUTTURE_RICETTIVE {\n    Nome_struttura,\n    Indirizzo,\n    Adesione_CETS,\n    Disponibilita_parcheggi,\n    Scuola,\n    Gruppi,\n    Email,\n    Num_telefono,\n    ID (id)\n}\nentity NOTIZIE {\n    Data,\n    Foto,\n    Testo,\n    COD (id)\n}\nentity RICHIESTE_PRENOTAZIONE {\n    Data_inizio_soggiorno,\n    Data_fine_soggiorno,\n    num_ospiti,\n    Stato_accettazione,\n    ID (id)\n}\nentity CERTIFICAZIONI_POSSEDUTE {\n    Nome_certificazione (id)\n}\nentity SERVIZI {\n    Nome_servizio (id)\n}\nentity TRATTAMENTI_DISPONIBILI {\n    Nome_trattamenti (id)\n}\nentity IMPEGNI_ECOLOGICI {\n    Nome_impegno (id)\n}\nentity LICENZE {\n    Nome_licenza (id)\n}\nentity SEGNALETICA {\n    Tipo_segnaletica,\n    ID (id)\n}\n\n/* Relationships */\nrelationship FORNISCE_INFORMAZIONI (\n    PARCHI: zero..many,\n    CENTRI_VISITA: one..one\n)\nrelationship CONTENGONO (\n    PARCHI: zero..many,\n    STRUTTURE_RICETTIVE: one..many\n)\nrelationship EFFETTUANO (\n    VISITATORI: zero..many,\n    TOUR_PROGRAMMATI: one..many\n)\nrelationship RILEVA (\n    PRESENZE: one..one,\n    VISITATORI: zero..many\n)\nrelationship VENGONO_VALUTATE (\n    VALUTAZIONI: one..one,\n    GUIDE_AUTORIZZATE: zero..many\n)\nrelationship ORGANIZZANO (\n    GUIDE_AUTORIZZATE: one..many,\n    TOUR_PROGRAMMATI: one..many\n)\nrelationship ABILITATE (\n    ITINERARI: zero..many,\n    GUIDE_AUTORIZZATE: one..many\n)\nrelationship INFORMANO (\n    NOTIZIE: one..many,\n    PARCHI: zero..many\n)\nrelationship TRACCIA (\n    PARCHI: zero..many,\n    PRESENZE: one..one\n)\nrelationship VALUTANO (\n    VISITATORI: zero..many,\n    VALUTAZIONI: one..one\n)\nrelationship VALUTATI (\n    ITINERARI: zero..many,\n    VALUTAZIONI: one..one\n)\nrelationship SI_POSSONO_CONSULTARE (\n    PARCHI: one..many,\n    ITINERARI: zero..many\n)\nrelationship INVIA (\n    VISITATORI: zero..many,\n    RICHIESTE_PRENOTAZIONE: zero..many\n)\nrelationship ALLOGGIANO (\n    STRUTTURE_RICETTIVE: zero..many,\n    VISITATORI: zero..many\n)\nrelationship SEGUONO (\n    TOUR_PROGRAMMATI: one..one,\n    ITINERARI: zero..many\n)\nrelationship SEGUE (\n    STRUTTURE_RICETTIVE: zero..many,\n    IMPEGNI_ECOLOGICI: zero..many\n)\nrelationship OFFRE (\n    STRUTTURE_RICETTIVE: one..many,\n    SERVIZI: one..many\n)\nrelationship ADOTTANO (\n    TRATTAMENTI_DISPONIBILI: one..many,\n    STRUTTURE_RICETTIVE: one..many\n)\nrelationship EROGANO (\n    CENTRI_VISITA: one..many,\n    SERVIZI: one..many\n)\nrelationship CONTIENE (\n    SEGNALETICA: one..many,\n    ITINERARI: zero..many\n)\nrelationship POSSIEDONO (\n    GUIDE_AUTORIZZATE: one..many,\n    LICENZE: zero..many\n)\nrelationship DISPONE_DI (\n    CERTIFICAZIONI_POSSEDUTE: zero..many,\n    PARCHI: zero..many\n)","sqlCode":"","itemsArray":[{"__type":"