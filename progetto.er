{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":168,"erCode":"/* Entities */\nentity PARCHI {\n    Tipologia,\n    Ente_Gestore,\n    Regione,\n    Superficie_terrestre,\n    Nome_parco,\n    Superficie_marina,\n    provvedimento_istitutivo,\n    Km_costa,\n    ID (id),\n    Certificazioni_possedute (optional, multi)\n}\nentity CENTRI_VISITA {\n    Contatti {\n        Email,\n        Num_telefono\n    },\n    Informazioni {\n        Percorsi,\n        Visite\n    },\n    Orario_apertura,\n    Servizi (multi),\n    Luogo (id),\n    Orario_chiusura,\n    Nome_centro (id)\n}\nentity VISITATORI {\n    Password,\n    Tipologia,\n    Username (id)\n}\nentity VALUTAZIONI {\n    Commento,\n    ID (id),\n    Punteggio\n}\nentity PRESENZE {\n    Tipologia_utente,\n    Orario_entrata,\n    Orario_uscita,\n    Data (external)\n}\nentity GUIDE_AUTORIZZATE {\n    Cognome (id),\n    Nome (id),\n    Licenze (multi),\n    Media_valutazione\n}\nentity ITINERARI {\n    ID (id),\n    Media_valutazione,\n    Numero_guide_abilitate,\n    Tempo_stimato,\n    Modalita_percorrenza,\n    Punto_partenza,\n    Livello_difficolta,\n    Segnaletica (multi)\n}\nentity TOUR_PROGRAMMATI {\n    Num_massimo_partecipanti,\n    Orario (id)\n}\nentity STRUTTURE_RICETTIVE {\n    Nome_struttura (id),\n    Impegni_ecologici (optional, multi),\n    Servizi_offerti (multi),\n    Indirizzo (id),\n    Contatti {\n        Email,\n        Num_telefono\n    },\n    Adesione_CETS,\n    Attrezzature {\n        Gruppi,\n        Scuole\n    },\n    Trattamenti_disponibili (multi),\n    Disponibilita_parcheggi\n}\nentity NOTIZIE {\n    Data (id),\n    Foto,\n    Testo (id)\n}\nentity TOUR_PROGRAMMATI_CORRENTI {\n    Stato\n}\nentity TOUR_PROGRAMMATI_STORICO {\n    Anno\n}\nentity RICHIESTE_PRENOTAZIONE {\n    Data_inizio_soggiorno (id),\n    Data_fine_soggiorno (id),\n    num_ospiti,\n    Stato_accettazione\n}\n\n/* Relationships */\nrelationship FORNISCE_INFORMAZIONI (\n    PARCHI: zero..many,\n    CENTRI_VISITA: one..one\n)\nrelationship CONTIENE (\n    PARCHI: zero..many,\n    STRUTTURE_RICETTIVE: one..many\n)\nrelationship EFFETTUANO (\n    VISITATORI: zero..many,\n    TOUR_PROGRAMMATI: one..many\n)\nrelationship RILEVA (\n    PRESENZE: one..one external,\n    VISITATORI: zero..many\n)\nrelationship VENGONO_VALUTATE (\n    VALUTAZIONI: one..one,\n    GUIDE_AUTORIZZATE: zero..many\n)\nrelationship ORGANIZZANO (\n    GUIDE_AUTORIZZATE: one..many,\n    TOUR_PROGRAMMATI: one..many\n)\nrelationship ABILITATE (\n    ITINERARI: zero..many,\n    GUIDE_AUTORIZZATE: one..many\n)\nrelationship INFORMANO (\n    NOTIZIE: one..many,\n    PARCHI: zero..many\n)\nrelationship TRACCIA (\n    PARCHI: zero..many,\n    PRESENZE: one..one external\n)\nrelationship VALUTANO (\n    VISITATORI: zero..many,\n    VALUTAZIONI: one..one\n)\nrelationship VALUTATI (\n    ITINERARI: zero..many,\n    VALUTAZIONI: one..one\n)\nrelationship SI_POSSONO_CONSULTARE (\n    PARCHI: one..many,\n    ITINERARI: zero..many\n)\nrelationship INVIA (\n    VISITATORI: zero..many,\n    RICHIESTE_PRENOTAZIONE: zero..many\n)\nrelationship ALLOGGIANO (\n    STRUTTURE_RICETTIVE: zero..many,\n    VISITATORI: zero..many\n)\nrelationship SEGUONO (\n    TOUR_PROGRAMMATI: one..one,\n    ITINERARI: zero..many\n)\n\n/* Generalizations */\nTOUR_PROGRAMMATI <= {\n    TOUR_PROGRAMMATI_STORICO,\n    TOUR_PROGRAMMATI_CORRENTI\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":5,"_name":"PARCHI","_x":-261,"_y":-246,"_mag":false},{"__type":"Attribute","_id":6,"_name":"Tipologia","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":5,"_x":-243,"_y":-30},{"__type":"Attribute","_id":7,"_name":"Ente_Gestore","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":5,"_x":-231,"_y":-80},{"__type":"Attribute","_id":8,"_name":"Region